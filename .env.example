# ---------------------------------------------------------------------------
# tinysaas configuration. Copy to .env and adjust. Every value has a default
# that matches the local development services described in the README.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
ENVIRONMENT=local                     # local | staging | production | test
LOG_LEVEL=INFO
# LOG_JSON=                           # unset -> pretty logs locally, JSON elsewhere
API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:3000 # used to build the email links
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
# TRUSTED_PROXIES=my-proxy.internal  # only then is X-Forwarded-For honoured

# --- PostgreSQL ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres_strong_pass@127.0.0.1:5432/tests
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# --- Redis (rate limiting + arq task queue) --------------------------------
REDIS_URL=redis://:redis_strong_pass@127.0.0.1:6379/0

# --- object storage (S3 compatible / RustFS) ------------------------------
STORAGE_BACKEND=s3                    # s3 | memory
S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000   # host used inside presigned URLs
S3_REGION=us-east-1
S3_ACCESS_KEY=RUSTFSadmin
S3_SECRET_KEY=RUSTFS_strong_pass
S3_BUCKET=tinysaas
S3_USE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true
UPLOAD_MAX_BYTES=5242880
PRESIGN_TTL_SECONDS=900

# --- security --------------------------------------------------------------
JWT_SECRET_KEY=dev-insecure-change-me-please-32-bytes-min  # CHANGE ME (>= 32 bytes)
JWT_ALGORITHM=HS256
JWT_ISSUER=tinysaas
JWT_AUDIENCE=tinysaas-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=1800
API_KEY_PREFIX=tsk
API_KEY_TTL_DAYS=365
REQUIRE_EMAIL_VERIFICATION=false
REFRESH_TRANSPORT=body                # body | cookie
REFRESH_COOKIE_NAME=ts_refresh
REFRESH_COOKIE_SECURE=false
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# --- payments (Stripe sandbox) --------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_STARTER=price_replace_me_starter
STRIPE_PRICE_PRO=price_replace_me_pro
STRIPE_PRICE_SCALE=price_replace_me_scale
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancel

# --- email (console writes var/mail/*.html) -------------------------------
MAILER=console                        # console | resend
MAIL_FROM=Tiny SaaS <no-reply@tinysaas.local>
MAIL_OUTBOX_DIR=var/mail
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
APP_NAME=Tiny SaaS
SUPPORT_EMAIL=support@tinysaas.local

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_PASSWORD_RESET_PER_15_MINUTES=3
RATE_LIMIT_SERVICE_PER_MINUTE=60

# --- observability ---------------------------------------------------------
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- demo / seeding --------------------------------------------------------
DEMO_EXECUTOR_ENABLED=true            # built-in echo / slow-report handlers
HTTP_PROXY_TIMEOUT_SECONDS=60
ADMIN_EMAIL=admin@tinysaas.local
ADMIN_PASSWORD=admin12345
